{
  "name": "paperwork",
  "module": "server.ts",
  "scripts": {
    "generate": "drizzle-kit generate --config=./drizzle/drizzle.config.ts",
    "push": "drizzle-kit push --config=./drizzle/drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config=./drizzle/drizzle.config.ts",
    "pull": "drizzle-kit pull --config=./drizzle/drizzle.config.ts",
    "drop": "drizzle-kit drop --config=./drizzle/drizzle.config.ts",
    "dev": "NODE_ENV=local bun --watch server.ts",
    "build": "bun build server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "seed": "bun run ./drizzle/seed.ts",
    "test": "bun test"
  },
  "type": "module",
  "devDependencies": {
    "better-sqlite3": "^11.9.0",
    "drizzle-kit": "^0.30.5"
  },
  "peerDependencies": {
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.2.0",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/html": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@elysiajs/swagger": "^1.2.2",
    "@libsql/client": "^0.14.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@types/bun": "latest",
    "better-auth": "^1.2.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "drizzle-typebox": "^0.2.1",
    "elysia": "^1.2.25",
    "jose": "^5.10.0",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5",
    "ulid": "^2.3.0"
  },
  "overrides": {
    "bun-types": "^1.1.43-canary.20250108T140520"
  }
}