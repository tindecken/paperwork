{
  "name": "paperwork",
  "module": "server.ts",
  "scripts": {
    "generate": "drizzle-kit generate --config=./drizzle/drizzle.config.ts",
    "push": "bun --env-file=.env.local drizzle-kit push --config=./drizzle/drizzle.config.ts",
    "migrate": "bun --env-file=.env.local drizzle-kit migrate --config=./drizzle/drizzle.config.ts",
    "pull": "bun --env-file=.env.local drizzle-kit pull --config=./drizzle/drizzle.config.ts",
    "drop": "bun --env-file=.env.local drizzle-kit drop --config=./drizzle/drizzle.config.ts",
    "dev": "NODE_ENV=local bun --watch server.ts",
    "build": "bun build server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "seed": "bun run ./drizzle/seed.ts",
    "test": "bun test"
  },
  "type": "module",
  "devDependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.30.6"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.3.0",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/html": "^1.3.0",
    "@elysiajs/jwt": "^1.3.0",
    "@elysiajs/swagger": "^1.3.0",
    "@libsql/client": "^0.14.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@types/bun": "latest",
    "better-auth": "^1.2.8",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.38.4",
    "drizzle-typebox": "^0.2.1",
    "elysia": "^1.3.1",
    "jose": "^5.10.0",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5",
    "ulid": "^2.4.0"
  }
}